# Supabase — Staging/Dev instance (SOP/GRC/DEV-SPB/2026/008 bab 1.1 & 1.2)
# Ganti isi file ini di server Staging/Production, JANGAN ubah kode.
# Lokasi nilai: Supabase Dashboard -> Connect panel -> API keys
NUXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NUXT_PUBLIC_SUPABASE_KEY=YOUR_PUBLISHABLE_KEY

# Feature flags (SOP/GRC/DEV-SPB/2026/008 bab 1.3) — default false di Production
NUXT_PUBLIC_ENABLE_DELETE_EMPLOYEE=false
